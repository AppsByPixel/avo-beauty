# Copy to api/.env for local work. Real secrets live in a secret manager,
# never in the repo (go-live-checklist.md § Security).

# Owner / migrator connection. Runs DDL. Never serves a request.
DATABASE_URL=postgres://avo:avo_dev_password@localhost:5433/avo

# Application connection. Not the table owner — this is what makes the
# REVOKE UPDATE, DELETE on audit_log an actual control.
APP_DATABASE_URL=postgres://avo_app:avo_app_dev_password@localhost:5433/avo

NODE_ENV=development

# ---------------------------------------------------------------- gateway --
# PSP selection is a client decision that has not been made (CLAUDE.md
# § Escalate, don't guess). The gateway sits behind src/gateway/PaymentGateway
# with a sandbox driver; choosing the real one is this variable plus one adapter.
# `sandbox` settles payments nobody made, so env.ts refuses it in production.
GATEWAY_DRIVER=sandbox

# The key the PSP signs its callbacks with. REQUIRED in production: a webhook
# that cannot verify a signature is an unauthenticated credit endpoint. Outside
# production a missing key is generated per boot.
# GATEWAY_WEBHOOK_SECRET=at-least-sixteen-characters

# Seconds a signed callback stays acceptable — the replay window.
# GATEWAY_WEBHOOK_TOLERANCE_SECONDS=300
# Milliseconds. POST /topups calls the gateway inside its transaction, so the
# ceiling is what keeps that defensible.
# GATEWAY_TIMEOUT_MS=8000

# Where the sandbox's hosted page lives. Absolute — TopUpIntent.redirectUrl is
# a URL, not a path.
# PUBLIC_BASE_URL=http://localhost:3000
# api-contract.md § TopUpIntent: where the gateway returns the customer.
# TOPUP_RETURN_URL=avo://topup/return

# docker-compose overrides (all optional, defaults shown)
# POSTGRES_PORT=5433
# POSTGRES_USER=avo
# POSTGRES_PASSWORD=avo_dev_password
# POSTGRES_DB=avo
# APP_DB_PASSWORD=avo_app_dev_password
