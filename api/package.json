{
  "name": "@avo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "build:function": "node scripts/build-function.mjs",
    "job:no-show": "tsx --env-file-if-exists=.env src/jobs/no-show-once.ts",
    "job:campaign-release": "tsx --env-file-if-exists=.env src/jobs/campaign-release-once.ts",
    "job:erasure": "tsx --env-file-if-exists=.env src/jobs/erasure-once.ts",
    "job:topup-reap": "tsx --env-file-if-exists=.env src/jobs/topup-reap-once.ts",
    "job:image-reap": "tsx --env-file-if-exists=.env src/jobs/image-reap-once.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "db:reset": "docker compose down -v && docker compose up -d --wait && pnpm run db:migrate",
    "db:verify": "bash scripts/db-verify.sh",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run --config vitest.int.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@avo/tokens": "workspace:*",
    "@avo/types": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@node-rs/argon2": "^2.1.0",
    "drizzle-orm": "^0.38.2",
    "fastify": "^5.2.0",
    "jose": "^6.2.9",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
