{
  "expo": {
    "name": "AVO Wallet",
    "slug": "avo-wallet",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "avo",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "beauty.avo.wallet"
    },
    "android": {
      "package": "beauty.avo.wallet",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-font"]
  }
}
