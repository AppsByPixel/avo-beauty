{
  "name": "avo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "tokens": "pnpm --filter @avo/tokens run build",
    "db:generate": "pnpm --filter @avo/api run db:generate",
    "db:migrate": "pnpm --filter @avo/api run db:migrate",
    "mock": "pnpm --filter @avo/mock run dev",
    "check": "turbo run typecheck lint test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.2",
      "react": "19.2.3",
      "react-dom": "19.2.3"
    }
  }
}
